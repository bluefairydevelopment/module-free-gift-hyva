# Static analysis for bluefairy/module-free-gift-hyva.
# Run from the package root, with MAGENTO_ROOT set:
#   MAGENTO_ROOT=/path/to/magento /path/to/magento/vendor/bin/phpstan analyse
#
# THIS FILE DID NOT EXIST UNTIL 2026-11-27. In the module-free-gift monorepo the
# phpstan configuration lived at the REPOSITORY ROOT and listed all three packages'
# paths. Extracting this package left the configuration behind, so it shipped with
# nothing to analyse it. The rig gate caught it: `the "phpcs.xml.dist" coding
# standard is not installed` on the sibling check, and a phpstan step with no config.
parameters:
    # THE LOWER BOUND OF THE COMPOSER CONSTRAINT, MADE SELF-POLICING.
    # composer.json admits "~8.3.0||~8.4.0||~8.5.0", and a constraint is a claim about
    # EVERY version it admits. Analysing at the LOWEST one turns that from an assertion
    # into something the analysis fails on - an 8.4-only construct is reported here
    # rather than at parse time on a customer's server.
    # RAISE THIS ONLY WITH THE COMPOSER CONSTRAINT: they are one claim in two files, and
    # the failure mode of them disagreeing is silent.
    phpVersion: 80300
    level: 5
    paths:
        # Every PHP file this package ships. There is no Block/, Model/ or Plugin/
        # directory: the components are Alpine.js in templates, and the only class is
        # the observer that registers the module with Hyva's config generator. phpstan
        # REFUSES to run on a path that is not there rather than skipping it, so this
        # list has to follow a deletion.
        - Observer
        - registration.php
    excludePaths:
        # Shipped code only. Unit tests are PHPUnit's concern, and mocks defeat static typing.
        - */Test/*
        - */docs/*
        - */docs-build/*
        - */node_modules/*
    bootstrapFiles:
        - Test/bootstrap.php
    treatPhpDocTypesAsCertain: false
